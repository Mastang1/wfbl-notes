# Adapted from config/examples/stm32f407-discovery.config (wolfBoot v2.10.0).
# 正点原子 STM32F407ZGT6, 8 MHz HSE, nominal VDD=3.3V.
ARCH?=ARM
TARGET?=stm32f4
SIGN?=ED25519
HASH?=SHA256
VTOR?=1
SPMATH?=1
WOLFBOOT_PARTITION_SIZE?=0x40000
WOLFBOOT_SECTOR_SIZE?=0x20000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x08020000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x08060000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x080A0000
CLOCK_SPEED?=168000000
STM32_PLLM?=8
STM32_PLLN?=336
STM32_PLLP?=2
STM32_PLLQ?=7
